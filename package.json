{
  "name": "@narraiva/dsh",
  "version": "0.0.1",
  "private": true,
  "description": "Narraiva local-first long-form writing profile for DeepSeek Harness",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "presets",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:contract": "node --test test/foundation-contract.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "pretest": "pnpm run build:client",
    "bootstrap": "node scripts/bootstrap-local-profile.mjs",
    "verify:profile": "node scripts/verify-profile-composition.mjs",
    "start:spike": "node scripts/start-local-spike.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "immediately": true
    }
  }
}
